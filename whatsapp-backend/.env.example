HOST=127.0.0.1
PORT=3001
# Enable only on the backend that will connect real accounts.
ASLNS_ENABLE_LIVE_WHATSAPP=false
ASLNS_ALLOWED_ORIGINS=http://localhost:5173,https://aslns.online,https://www.aslns.online
# Set to the exact number of trusted reverse-proxy hops in your deployment.
# ASLNS_PROXY_HOPS=1
# Optional absolute directory on persistent storage. One instance owns it.
# ASLNS_RUNTIME_DIR=/var/lib/aslns-whatsapp
